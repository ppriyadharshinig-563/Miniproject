# ==============================================================================
# CampusTransit - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root to configure your environment.
# Never commit your actual '.env' file or production API keys to git.
# ==============================================================================

# Google Maps JavaScript API Restricted Browser Key
# ------------------------------------------------------------------------------
# 1. Create a Google Cloud Project at https://console.cloud.google.com/
# 2. Enable Billing on the project.
# 3. Enable 'Maps JavaScript API' and 'Directions API' (or 'Routes API').
# 4. Create an API Key in Credentials and configure:
#    - Application Restrictions: 'Websites' (HTTP referrers: e.g. http://localhost:8080/*, http://127.0.0.1:8080/*)
#    - API Restrictions: Restrict key to 'Maps JavaScript API' and 'Directions API'
# 5. Paste the browser key below:
GOOGLE_MAPS_BROWSER_KEY=

# Map Center Defaults (Perundurai, Erode District, Tamil Nadu)
# ------------------------------------------------------------------------------
MAP_DEFAULT_LAT=11.2748
MAP_DEFAULT_LNG=77.5828
MAP_DEFAULT_ZOOM=12

# College Destination Hub (Kongu Engineering College, Perundurai)
# ------------------------------------------------------------------------------
COLLEGE_DESTINATION_NAME=Kongu Engineering College
COLLEGE_DESTINATION_LAT=11.2742
COLLEGE_DESTINATION_LNG=77.6070
